rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAgent() { return isSignedIn() && (role() == 'agent' || role() == 'admin'); }
    function isAdmin() { return isSignedIn() && role() == 'admin'; }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /categories/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /tickets/{ticketId} {
      allow read: if isAgent() ||
        (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.customerId == request.auth.uid;
      allow update: if isAgent() ||
        (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAgent() ||
          (isSignedIn() && get(/databases/$(database)/documents/tickets/$(ticketId)).data.customerId == request.auth.uid &&
           resource.data.internal != true);
        allow create: if isSignedIn() && (
          isAgent() ||
          (get(/databases/$(database)/documents/tickets/$(ticketId)).data.customerId == request.auth.uid &&
           request.resource.data.internal != true)
        );
        allow update, delete: if isAdmin();
      }
    }

    match /settings/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
